+{
+}
+
+int websocket_create(const NETADDR *pBindAddr)
+{
+	(void)pBindAddr;
+	for(int i = 0; i < MAX_WEBSOCKET_CONTEXTS; i++)
+	{
+		if(!g_aContexts[i].m_Used)
+		{
+			g_aContexts[i].m_vConnections.clear();
+			g_aContexts[i].m_Used = true;
+			return i;
+		}
+	}
+	log_error("websockets", "no free WebSocket context available");
+	return -1;
+}
+
+void websocket_destroy(int Socket)
+{
+	SWebSocketContext *pContext = GetContext(Socket);
+	if(pContext == nullptr)
+	{
+		return;
+	}
+	for(const SWebSocketConnection &Connection : pContext->m_vConnections)
+	{
+		ddws_close(Connection.m_Slot);
+	}
+	pContext->m_vConnections.clear();
+	pContext->m_Used = false;
+}
+
+int websocket_send(int Socket, const unsigned char *pData, size_t Size, const NETADDR *pAddr)
+{
