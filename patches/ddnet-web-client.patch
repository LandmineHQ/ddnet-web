+namespace {
+
+constexpr int MAX_WEBSOCKET_CONTEXTS = 4;
+constexpr int MAX_WEBSOCKET_CONNECTIONS = 32;
+// A relay URL plus path, authentication token and protocol query has to fit.
+constexpr int MAX_WEBSOCKET_URL_LENGTH = 1024;
+
+struct SWebSocketConnection
+{
+	NETADDR m_Addr;
+	int m_Slot = -1;
+	bool m_LoggedTransport = false;
+};
+
+struct SWebSocketContext
+{
+	bool m_Used = false;
+	std::vector<SWebSocketConnection> m_vConnections;
+	// Throttle reopening dead WebSocket slots: the browser closes sockets on relay
+	// idle timeout / network changes, but CNetClient keeps the NETADDR cached. Without
+	// a cooldown a failed send would reopen a socket on every outgoing packet.
+	int64_t m_NextOpenTick = 0;
+};
+
+SWebSocketContext g_aContexts[MAX_WEBSOCKET_CONTEXTS] = {};
+// WebSocket URL by hash of the URL, which is stored in the NETADDR IP field.
+std::unordered_map<uint32_t, std::string> g_UrlByHash;
+// Relay used for plain "host:port" addresses, e.g. "wss://relay.example.com:8443".
+char g_aDefaultRelay[MAX_WEBSOCKET_URL_LENGTH] = "";
+// Optional query string appended to relay URLs, e.g. "token=secret".
+char g_aDefaultRelayQuery[512] = "";
+
+uint32_t HashString(const char *pStr)
+{
+	uint32_t Hash = 2166136261u; // FNV-1a
+	for(const char *p = pStr; *p != '\0'; p++)
+	{
+		Hash ^= (uint8_t)*p;
+		Hash *= 16777619u;
+	}
+	return Hash;
+}
+
+uint32_t AddrHash(const NETADDR *pAddr)
+{
+	uint32_t Hash = 0;
+	mem_copy(&Hash, pAddr->ip, sizeof(Hash));
+	return Hash;
+}
+
+SWebSocketContext *GetContext(int Socket)
+{
+	if(Socket < 0 || Socket >= MAX_WEBSOCKET_CONTEXTS || !g_aContexts[Socket].m_Used)
+	{
+		return nullptr;
+	}
+	return &g_aContexts[Socket];
+}
+
+int ParseWebSocketUrl(const char *pUrl, NETADDR *pAddr)
+{
+	const char *pRest;
+	bool Secure;
+	if(str_startswith_nocase(pUrl, "wss://"))
+	{
+		pRest = pUrl + 6;
+		Secure = true;
+	}
+	else if(str_startswith_nocase(pUrl, "ws://"))
+	{
+		pRest = pUrl + 5;
+		Secure = false;
+	}
+	else
+	{
+		return -1;
+	}
+
+	const int UrlLength = str_length(pUrl);
+	if(UrlLength <= 0 || UrlLength >= MAX_WEBSOCKET_URL_LENGTH)
+	{
+		log_error("websockets", "WebSocket URL has invalid length: %d", UrlLength);
+		return -1;
+	}
+
+	// The authority ends at the first '/', '?' or '#'.
+	const char *pAuthorityEnd = pRest;
+	while(*pAuthorityEnd != '\0' && *pAuthorityEnd != '/' && *pAuthorityEnd != '?' && *pAuthorityEnd != '#')
+	{
+		pAuthorityEnd++;
+	}
+	if(pAuthorityEnd == pRest)
+	{
+		log_error("websockets", "WebSocket URL has no host: '%s'", pUrl);
+		return -1;
+	}
+
+	// Strip optional userinfo.
+	for(const char *p = pRest; p < pAuthorityEnd; p++)
+	{
+		if(*p == '@')
+		{
+			pRest = p + 1;
+			break;
+		}
+	}
+	const char *pAuthority = pRest;
+
+	int Port = Secure ? 443 : 80;
+	if(*pAuthority == '[')
+	{
+		// Bracketed IPv6 address with optional port.
+		const char *pClose = pAuthority;
+		while(pClose < pAuthorityEnd && *pClose != ']')
+		{
+			pClose++;
+		}
+		if(pClose >= pAuthorityEnd)
+		{
+			log_error("websockets", "WebSocket URL has invalid IPv6 address: '%s'", pUrl);
+			return -1;
+		}
+		if(pClose + 1 < pAuthorityEnd)
+		{
+			if(*(pClose + 1) != ':')
+			{
+				log_error("websockets", "WebSocket URL has invalid IPv6 address: '%s'", pUrl);
+				return -1;
+			}
+			int ParsedPort = 0;
+			for(const char *p = pClose + 2; p < pAuthorityEnd; p++)
+			{
+				if(*p < '0' || *p > '9')
+				{
+					return -1;
+				}
+				ParsedPort = ParsedPort * 10 + (*p - '0');
+				if(ParsedPort > 65535)
+				{
+					return -1;
+				}
+			}
+			if(ParsedPort <= 0)
+			{
+				return -1;
+			}
+			Port = ParsedPort;
+		}
+	}
+	else
+	{
+		const char *pColon = nullptr;
+		for(const char *p = pAuthority; p < pAuthorityEnd; p++)
+		{
+			if(*p == ':')
+			{
+				pColon = p;
+			}
+		}
+		if(pColon != nullptr)
+		{
+			int ParsedPort = 0;
+			if(pColon + 1 >= pAuthorityEnd)
+			{
+				return -1;
+			}
+			for(const char *p = pColon + 1; p < pAuthorityEnd; p++)
+			{
+				if(*p < '0' || *p > '9')
+				{
+					log_error("websockets", "WebSocket URL has invalid port: '%s'", pUrl);
+					return -1;
+				}
+				ParsedPort = ParsedPort * 10 + (*p - '0');
+				if(ParsedPort > 65535)
+				{
+					return -1;
+				}
+			}
+			if(ParsedPort <= 0)
+			{
+				return -1;
+			}
+			Port = ParsedPort;
+		}
+	}
+
+	// Optional protocol selection in the query string, e.g.
+	//   wss://relay.example.com/udp/ddnet.example.org:8303?protocol=7
+	// requests the 0.7 (sixup) protocol instead of 0.6.
+	bool Sixup = false;
+	if(const char *pQuery = str_find(pUrl, "?"))
+	{
+		if(str_find(pQuery, "protocol=7") != nullptr ||
+			str_find(pQuery, "protocol=0.7") != nullptr ||
+			str_find(pQuery, "sevenup=1") != nullptr ||
+			str_find(pQuery, "tw7=1") != nullptr)
+		{
+			Sixup = true;
+		}
+	}
+
+	const uint32_t Hash = HashString(pUrl);
+	mem_zero(pAddr, sizeof(*pAddr));
+	mem_copy(pAddr->ip, &Hash, sizeof(Hash));
+	pAddr->port = Port;
+	pAddr->type = NETTYPE_WEBSOCKET_IPV4;
+	if(Sixup)
+	{
+		pAddr->type |= NETTYPE_TW7;
+	}
+
+	auto Existing = g_UrlByHash.find(Hash);
+	if(Existing != g_UrlByHash.end() && Existing->second != pUrl)
+	{
+		log_warn("websockets", "WebSocket URL hash collision between '%s' and '%s'", Existing->second.c_str(), pUrl);
+	}
+	g_UrlByHash[Hash] = pUrl;
+	return 0;
+}
+
+} // namespace
+
+bool websocket_addr_to_str(const NETADDR *pAddr, char *pBuf, int BufSize)
+{
+	const auto It = g_UrlByHash.find(AddrHash(pAddr));
+	if(It == g_UrlByHash.end())
+	{
+		return false;
+	}
+	str_copy(pBuf, It->second.c_str(), BufSize);
+	return true;
+}
+
+int websocket_addr_from_url(const char *pUrl, NETADDR *pAddr)
+{
+	return ParseWebSocketUrl(pUrl, pAddr);
+}
+
+int websocket_addr_from_plain(const char *pHostAndPort, NETADDR *pAddr, bool Sixup)
+{
+	if(g_aDefaultRelay[0] == '\0')
+	{
+		return -1;
+	}
+	// Build the relay URL that carries this plain address, e.g.
+	//   wss://relay.example.com:8443/udp/game.example.org:8303?token=...&protocol=7
+	// The relay is a dumb datagram pipe, so the target is only used to select the
+	// UDP destination. Keeping the protocol in the URL ensures that reconnecting
+	// from the URL (e.g. "try again" or a saved address) keeps the 0.7 flag.
+	char aQuery[sizeof(g_aDefaultRelayQuery) + 32];
+	str_copy(aQuery, g_aDefaultRelayQuery, sizeof(aQuery));
+	if(Sixup)
+	{
+		if(aQuery[0] != '\0')
+		{
+			str_append(aQuery, "&", sizeof(aQuery));
+		}
+		str_append(aQuery, "protocol=7", sizeof(aQuery));
+	}
+	char aUrl[MAX_WEBSOCKET_URL_LENGTH];
+	if(aQuery[0] != '\0')
+	{
+		str_format(aUrl, sizeof(aUrl), "%s/udp/%s?%s", g_aDefaultRelay, pHostAndPort, aQuery);
+	}
+	else
+	{
+		str_format(aUrl, sizeof(aUrl), "%s/udp/%s", g_aDefaultRelay, pHostAndPort);
+	}
+	return ParseWebSocketUrl(aUrl, pAddr);
+}
+
+void websocket_set_default_relay(const char *pUrl, const char *pQuery)
+{
+	str_copy(g_aDefaultRelay, pUrl, sizeof(g_aDefaultRelay));
+	while(str_length(g_aDefaultRelay) > 0 && g_aDefaultRelay[str_length(g_aDefaultRelay) - 1] == '/')
+	{
+		g_aDefaultRelay[str_length(g_aDefaultRelay) - 1] = '\0';
+	}
+	str_copy(g_aDefaultRelayQuery, pQuery != nullptr ? pQuery : "", sizeof(g_aDefaultRelayQuery));
+	const char *pQueryStart = g_aDefaultRelayQuery;
+	while(*pQueryStart == '?' || *pQueryStart == '&')
+	{
+		pQueryStart++;
+	}
+	if(pQueryStart != g_aDefaultRelayQuery)
+	{
+		mem_move(g_aDefaultRelayQuery, pQueryStart, str_length(pQueryStart) + 1);
+	}
+	// Trailing separators would produce "...?token=x&", which relays tolerate, but
+	// keeping the URL canonical makes the address hash stable.
+	while(str_length(g_aDefaultRelayQuery) > 0 && (g_aDefaultRelayQuery[str_length(g_aDefaultRelayQuery) - 1] == '&' || g_aDefaultRelayQuery[str_length(g_aDefaultRelayQuery) - 1] == '?'))
+	{
+		g_aDefaultRelayQuery[str_length(g_aDefaultRelayQuery) - 1] = '\0';
+	}
+}
