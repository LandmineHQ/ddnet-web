+			if(websocket_addr_to_str(pAddr, aUrl, sizeof(aUrl)))
+			{
+				log_info("websockets", "transport for '%s': %s", aUrl,
+					Transport == 1 ? "WebRTC data channel (preferred)" : "WebSocket (fallback)");
+			}
+		}
+	}
+	return (int)Size;
+}
+
+int websocket_recv(int Socket, unsigned char *pData, size_t MaxSize, NETADDR *pAddr)
+{
+	SWebSocketContext *pContext = GetContext(Socket);
+	if(pContext == nullptr)
+	{
+		return 0;
+	}
+
+	int Index = 0;
+	while(Index < (int)pContext->m_vConnections.size())
+	{
+		SWebSocketConnection &Connection = pContext->m_vConnections[Index];
+		const int Bytes = ddws_poll(Connection.m_Slot, pData, (int)MaxSize);
+		if(Bytes > 0)
+		{
+			*pAddr = Connection.m_Addr;
+			return Bytes;
+		}
+		if(Bytes < 0)
+		{
+			char aUrl[MAX_WEBSOCKET_URL_LENGTH];
+			if(websocket_addr_to_str(&Connection.m_Addr, aUrl, sizeof(aUrl)))
+			{
+				log_warn("websockets", "WebSocket connection to '%s' was closed", aUrl);
+			}
+			ddws_close(Connection.m_Slot);
+			pContext->m_vConnections.erase(pContext->m_vConnections.begin() + Index);
+			continue;
+		}
+		Index++;
+	}
+	return 0;
+}
+
+int websocket_pending(int Socket)
+{
+	SWebSocketContext *pContext = GetContext(Socket);
+	if(pContext == nullptr)
+	{
+		return 0;
+	}
+	for(const SWebSocketConnection &Connection : pContext->m_vConnections)
+	{
+		if(ddws_pending(Connection.m_Slot) > 0)
+		{
+			return 1;
+		}
+	}
+	return 0;
+}
+
+int websocket_fd_set(int Socket, fd_set *pSet)
+{
+	(void)Socket;
+	(void)pSet;
+	return -1;
+}
+
+int websocket_fd_get(int Socket, fd_set *pSet)
+{
+	(void)Socket;
+	(void)pSet;
+	return 0;
+}
+
+// Called from the web frontend before starting the client to configure a relay that
+// is used for plain "host:port" server addresses (e.g. servers picked in the
+// in-game server browser, whose addresses come from the UDP master server list).
+// pQuery is an optional already URL-encoded query string, e.g. "token=secret".
+EM_JS(void, DDWeb_SetClipboardText, (const char *pText), {
+	const text = UTF8ToString(pText);
+	if (typeof globalThis.ddwebSetClipboardText === "function") {
+		globalThis.ddwebSetClipboardText(text);
+	}
+});
+
+EM_JS(void, DDWeb_SetTextInputActive, (int Active), {
+	if (typeof globalThis.ddwebTextInputActive === "function") {
+		globalThis.ddwebTextInputActive(Active ? true : false);
+	}
+});
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DDWeb_SetDefaultRelay(const char *pUrl, const char *pQuery)
+{
+	websocket_set_default_relay(pUrl, pQuery);
+	log_info("websockets", "default relay for plain server addresses: '%s' (query %s)", g_aDefaultRelay, g_aDefaultRelayQuery[0] != '\0' ? "set" : "empty");
+}
+
+#endif
