+void DDWeb_InputKey(int KeySym, int Pressed)
+{
+	SDL_Event Event;
+	SDL_zero(Event);
+	Event.type = Pressed ? SDL_KEYDOWN : SDL_KEYUP;
+	Event.key.type = Event.type;
+	Event.key.state = Pressed ? SDL_PRESSED : SDL_RELEASED;
+	Event.key.repeat = 0;
+	Event.key.keysym.sym = (SDL_Keycode)KeySym;
+	Event.key.keysym.scancode = SDL_GetScancodeFromKey((SDL_Keycode)KeySym);
+	SDL_PushEvent(&Event);
+}
 }
 #endif
 
