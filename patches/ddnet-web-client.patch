index 0000000..0ffb7ce
--- /dev/null
+++ b/src/engine/shared/websockets_emscripten.cpp
@@ -0,0 +1,746 @@
+#include "websockets.h"
+
+#if defined(CONF_PLATFORM_EMSCRIPTEN)
+
+#include <base/log.h>
+#include <base/mem.h>
+#include <base/net.h>
+#include <base/str.h>
+#include <base/time.h>
+
+#include <emscripten.h>
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+// Client-side WebSocket transport for the Emscripten (web browser) build.
+//
+// Browsers cannot open UDP sockets, so the only networking primitive available
+// to the web client is the JavaScript WebSocket API. This file implements the
+// same interface as the server-side libwebsockets based implementation in
+// websockets.cpp, but as a client: every `NETADDR` of type NETTYPE_WEBSOCKET_*
+// is associated with a full WebSocket URL (registered by net_host_lookup) and
+// every "UDP datagram" is mapped to exactly one binary WebSocket frame.
+//
+// The JavaScript side is polled instead of invoking callbacks into WebAssembly,
+// because the game runs on the browser main thread and WebSocket callbacks must
+// not re-enter the engine from arbitrary event loop turns. This keeps the
+// pthread + ASYNCIFY build of the client working without any locking.
+
+// clang-format off
+EM_JS(int, ddws_open, (const char *pUrl), {
+	var g = Module['DDWS'] || (Module['DDWS'] = { slots: [], free: [], mode: { webrtc: 0, ws: 0, fallback: 0 } });
+	if (!Module['DDWSStats']) Module['DDWSStats'] = { bytesIn: 0, bytesOut: 0 };
+	var idx = g.free.length > 0 ? g.free.pop() : g.slots.length;
+	var url = UTF8ToString(pUrl);
+	var rec = { ws: null, dc: null, pc: null, mode: 'pending', inq: [], outq: [], closed: false, opened: false };
+	g.slots[idx] = rec;
+
+	function flush() {
+		while (rec.outq.length > 0 && !rec.closed) {
+			var data = rec.outq.shift();
+			try {
+				if (rec.dc && rec.dc.readyState === 'open') rec.dc.send(data);
+				else if (rec.ws && rec.ws.readyState === 1) rec.ws.send(data);
+				else { rec.outq.unshift(data); return; }
+			} catch (e) { rec.closed = true; return; }
+		}
+	}
+
+	function openWS() {
+		if (rec.closed) return;
+		rec.mode = 'ws';
+		try {
