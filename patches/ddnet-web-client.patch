+	if(pContext == nullptr || Size == 0)
+	{
+		return -1;
+	}
+
+	SWebSocketConnection *pConnection = nullptr;
+	int ConnectionIndex = -1;
+	for(int i = 0; i < (int)pContext->m_vConnections.size(); i++)
