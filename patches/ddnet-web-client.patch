+	if(pConnection == nullptr)
+	{
+		// A slot failed recently; give it a moment instead of reconnecting in a busy loop.
+		if(time_get() < pContext->m_NextOpenTick)
+		{
+			return -1;
+		}
+		char aUrl[MAX_WEBSOCKET_URL_LENGTH];
+		if(!websocket_addr_to_str(pAddr, aUrl, sizeof(aUrl)))
+		{
+			log_error("websockets", "no WebSocket URL registered for this address, the web client can only use ws:// and wss:// addresses");
+			return -1;
+		}
+		if((int)pContext->m_vConnections.size() >= MAX_WEBSOCKET_CONNECTIONS)
+		{
+			log_error("websockets", "too many WebSocket connections, rejecting '%s'", aUrl);
+			return -1;
+		}
+		const int Slot = ddws_open(aUrl);
+		if(Slot < 0)
+		{
+			log_error("websockets", "failed to open WebSocket connection to '%s'", aUrl);
+			return -1;
+		}
+		pContext->m_vConnections.push_back(SWebSocketConnection{*pAddr, Slot});
+		pConnection = &pContext->m_vConnections.back();
+		ConnectionIndex = (int)pContext->m_vConnections.size() - 1;
+		log_info("websockets", "opened WebSocket connection to '%s'", aUrl);
